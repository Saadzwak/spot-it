# ─────────────────────────────────────────────────────────────
# Spot.it — variables d'environnement (copier en .env, NE PAS commit)
# Les clés réelles seront fournies au moment voulu. Tout placeholder.
# ─────────────────────────────────────────────────────────────

# ── CLIENT (inliné dans le bundle JS → PUBLIC, jamais de secret) ──
# Token Mapbox PUBLIC (pk.) — restreint par bundle id. Voie WebView.
EXPO_PUBLIC_MAPBOX_TOKEN=pk.PLACEHOLDER

# Style Mapbox Studio publié (terre crème, eau teintée, rues fines, labels masqués)
EXPO_PUBLIC_MAPBOX_STYLE=mapbox://styles/USERNAME/STYLEID

# Supabase (URL + clé anon = publiques, protégées par RLS)
EXPO_PUBLIC_SUPABASE_URL=https://PLACEHOLDER.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=PLACEHOLDER_ANON_KEY

# Active les appels réseau. false (défaut) => M0 100% local, zéro réseau.
EXPO_PUBLIC_USE_BACKEND=false

# ── SERVEUR (Supabase Edge Functions — JAMAIS dans le client) ──
# À poser via:  supabase secrets set ANTHROPIC_API_KEY=...
# ANTHROPIC_API_KEY=sk-ant-PLACEHOLDER
# SUPABASE_SERVICE_ROLE_KEY=PLACEHOLDER_SERVICE_ROLE
# SUPABASE_URL=https://PLACEHOLDER.supabase.co
